# Copy secrets into `.env.local` (gitignored). That file overrides development/production env files.
#
# Committed defaults:
#   .env.development  → used by `pnpm --filter @jlt/web dev`
#   .env.production   → used by `pnpm --filter @jlt/web build`
#
# Vercel: create two projects (Dev + Prod). Paste these keys into each project's
# Environment Variables. See docs/DEPLOY.md.

NEXT_PUBLIC_APP_ENV=development
# Production: set the real public domain (used for sitemap, canonicals, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp display line (1460). Voice calling is only on /contact (hardcoded).
NEXT_PUBLIC_SUPPORT_PHONE=+442080901460
NEXT_PUBLIC_SUPPORT_EMAIL=Info@nobletravel.co.uk
# WhatsApp numbers live in apps/web/src/lib/contact.ts (WHATSAPP_NUMBERS)
# Google Tag Manager (loads on every page via root layout).
NEXT_PUBLIC_GTM_ID=GTM-WGQLWH3J
# Optional direct GA4. Leave empty if GA4 is fired from GTM (avoids double counting).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Ads gtag (AW-…). Loads on every page via root layout.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18381676468
# Google Ads phone call conversion (website `tel:` tracking). Unused on-site now —
# 1460 is WhatsApp-only. Leave set if you still use call extensions in Ads.
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_ID=AW-18381676468/2qIPCPnAjeEcELS_iL1E
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_NUMBER=02080901460
# Google Ads click conversion for WhatsApp. Create a Click / WhatsApp conversion in Ads,
# then paste the AW-…/label. The site fires this once per click — do not also add a GTM Ads tag.
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_ID=

# Flight search (server-only). Leave mock on for local/dev without Duffel.
# For live baggage/fare/segment details: set DUFFEL_USE_MOCK=false and a test/live token.
DUFFEL_USE_MOCK=false
DUFFEL_ACCESS_TOKEN=

# Instalment service fee percent (listed fares are provider prices). Use 0 for no fee.
# Change only this value (or apps/web/src/lib/pricing.ts default).
FLIGHT_PRICE_MARKUP_PERCENT=5

# Server-side flight cache TTLs (Next.js only — no separate backend).
# Full search results (seconds). Default 600 = 10 minutes.
FLIGHT_SEARCH_CACHE_TTL_SECONDS=600
# Flexible-dates cheapest-by-day (seconds). Cache-only — tapping a day runs a live search.
FLIGHT_CALENDAR_CACHE_TTL_SECONDS=1800
# How long Duffel waits for each airline (ms). Must stay below the search route timeout (30s).
# DUFFEL_SUPPLIER_TIMEOUT_MS=15000

# Callback lead email (server-only). Optional in local development — requests still succeed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Elca Airbridge <onboarding@resend.dev>
LEADS_EMAIL_TO=Info@nobletravel.co.uk
