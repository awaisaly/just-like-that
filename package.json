{
  "name": "just-like-that",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "build:prod": "pnpm --filter @jlt/shared build && pnpm --filter @jlt/web build:prod",
    "start:prod": "pnpm --filter @jlt/web start:prod",
    "prod": "pnpm build:prod && pnpm start:prod",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
